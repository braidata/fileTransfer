{
  "schema": "braidata.connect.v1",
  "room": {
    "mode": "persistent",
    "host": {
      "authentication": "neon-postgres-jwt",
      "recoverable": true,
      "saveSnapshot": true
    },
    "guests": {
      "enabled": true,
      "entry": "invite-link",
      "urlPattern": "?room={code}",
      "auth": "room-scoped-signed-jwt",
      "displayNameRequired": true,
      "persistIdentity": "browser-local-storage",
      "privileges": [
        "chat.message",
        "player.input",
        "read.room",
        "read.events"
      ],
      "restricted": [
        "create",
        "resume",
        "snapshot",
        "game.event",
        "kick"
      ],
      "hostCanKick": true
    },
    "events": {
      "transport": "http-polling",
      "pollMs": 3500,
      "persisted": true
    },
    "voice": {
      "transport": "peerjs",
      "note": "separate experimental P2P playground"
    }
  }
}
